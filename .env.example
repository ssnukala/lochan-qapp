# __PROJECT_NAME__ — bootstrap environment
#
# Copy this file to .env and fill in the three bootstrap secrets below.
# Everything else (LLM API keys, OAuth secrets, SMTP credentials) lives
# encrypted in LOCKBOX — push via `daksh secrets push __PROJECT_NAME__`.
#
# .env must NEVER be committed. .gitignore already excludes it.

# --- Bootstrap tier (required, stay in this file) --------------------

# Postgres password — pick something strong. Used by the compose stack
# to authenticate the backend to its own database.
POSTGRES_PASSWORD=CHANGE_ME_PICK_A_STRONG_PASSWORD

# Master encryption key for LOCKBOX (Fernet-compatible 32-byte base64).
# Generate: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_FRESH_FERNET_KEY

# JWT signing secret (any strong random string, 32+ bytes).
# Generate: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_A_FRESH_JWT_SECRET

# --- Infra (non-secret runtime config) -------------------------------

POSTGRES_USER=lochan
POSTGRES_DB=__PROJECT_NAME__
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000

LOG_LEVEL=info
VAULT_LOCKBOX=__PROJECT_NAME__
